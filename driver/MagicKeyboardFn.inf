; MagicKeyboardFn (Orchard Keys): function-row, Fn and Lock mapping for the USB-C Apple Magic Keyboard
; (05AC:0320) and the Magic Keyboard 2 (2015, A1644, 05AC:0267).
; Installs HidUsb from input.inf with VHF and MagicKeyboardFn as lower filters, plus the
; settings tray app, which starts at sign-in from the driver store.

[Version]
Signature   = "$WINDOWS NT$"
Class       = HIDClass
ClassGuid   = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider    = %Provider%
CatalogFile = MagicKeyboardFn.cat
DriverVer   = 11/11/2026,1.3.0.0
PnpLockdown = 1

[DestinationDirs]
MagicKb_Files = 13

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
MagicKeyboardFn.sys = 1
MagicKeyboardControls.exe = 1

[Manufacturer]
%Manufacturer% = MagicKb_Models, NTamd64

[MagicKb_Models.NTamd64]
%DeviceDesc% = MagicKb_Inst, USB\VID_05AC&PID_0320&MI_01
%AuxDesc%    = MagicKb_Aux, USB\VID_05AC&PID_0320&MI_00
%BtDesc%     = MagicKb_Bt, BTHENUM\{00001124-0000-1000-8000-00805f9b34fb}_VID&0001004c_PID&0320
; Magic Keyboard 2 (2015): the same reports, with Eject (byte 9 bit 0) in the place of Lock
%DeviceDesc2% = MagicKb_Inst, USB\VID_05AC&PID_0267&MI_01
%AuxDesc2%    = MagicKb_Aux, USB\VID_05AC&PID_0267&MI_00
%BtDesc2%     = MagicKb_Bt, BTHENUM\{00001124-0000-1000-8000-00805f9b34fb}_VID&0001004c_PID&0267

[MagicKb_Inst.NT]
Include   = input.inf
Needs     = HID_Inst.NT
CopyFiles = MagicKb_Files
AddReg    = MagicKb_Tray

[MagicKb_Files]
MagicKeyboardFn.sys
MagicKeyboardControls.exe

[MagicKb_Tray]
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Run","MagicKeyboardControls",0x00000000,"""%13%\MagicKeyboardControls.exe"" --agent"

[MagicKb_Inst.NT.HW]
Include = input.inf
Needs   = HID_Inst.NT.HW
AddReg  = MagicKb_Filters

; vhf must sit below MagicKeyboardFn (the first entry attaches lowest)
[MagicKb_Filters]
HKR,,"LowerFilters",0x00010000,"vhf","MagicKeyboardFn"

; Interface 0 carries the battery report (input report 0x90). Its HID report descriptor is
; invalid for Windows' HID parser (HidUsb fails with Code 10), so it gets WinUSB instead and
; the tray app asks for the report with a class GET_REPORT control request.
[MagicKb_Aux.NT]
Include = winusb.inf
Needs   = WINUSB.NT

[MagicKb_Aux.NT.HW]
AddReg = MagicKb_AuxReg

[MagicKb_AuxReg]
HKR,,"DeviceInterfaceGUIDs",0x00010000,"{8C4D7C2A-4B6E-4F7B-9E3A-6A1F0D5B2E91}"

[MagicKb_Aux.NT.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

; Bluetooth: the in-box HidBth driver, with VHF and MagicKeyboardFn below it. The keyboard
; sends the same input report over Bluetooth, so the same filter maps it.
[MagicKb_Bt.NT]
; Needs entries do not nest, so HID_Inst.NT (which HIDBTH_Inst.NT itself needs) is listed too.
Include   = hidbth.inf, input.inf
Needs     = HIDBTH_Inst.NT, HID_Inst.NT
CopyFiles = MagicKb_Files
AddReg    = MagicKb_Tray

[MagicKb_Bt.NT.HW]
Include = hidbth.inf
Needs   = HIDBTH_Inst.NT.HW
AddReg  = MagicKb_Filters

[MagicKb_Bt.NT.Services]
Include    = hidbth.inf
Needs      = HIDBTH_Inst.NT.Services
AddService = MagicKeyboardFn,,MagicKb_Service

[MagicKb_Inst.NT.Services]
Include    = input.inf
Needs      = HID_Inst.NT.Services
AddService = MagicKeyboardFn,,MagicKb_Service

[MagicKb_Service]
DisplayName   = %ServiceDesc%
ServiceType   = 1 ; SERVICE_KERNEL_DRIVER
StartType     = 3 ; SERVICE_DEMAND_START
ErrorControl  = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\MagicKeyboardFn.sys

[Strings]
Provider     = "Orchard Keys"
Manufacturer = "Apple Inc."
DeviceDesc   = "Orchard Keys Magic Keyboard (USB-C)"
AuxDesc      = "Orchard Keys Magic Keyboard Battery (USB-C)"
BtDesc       = "Orchard Keys Magic Keyboard (Bluetooth)"
DeviceDesc2  = "Orchard Keys Magic Keyboard 2"
AuxDesc2     = "Orchard Keys Magic Keyboard 2 Battery"
BtDesc2      = "Orchard Keys Magic Keyboard 2 (Bluetooth)"
ServiceDesc  = "Orchard Keys Fn mapping filter"
DiskName     = "Orchard Keys driver disk"
